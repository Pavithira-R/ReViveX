rules_version = '2';

// ReViveX – Cloud Firestore security rules.
// Paste into Firebase console → Firestore Database → Rules → Publish.
// Each module adds its own block in the marked section below.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Shared helpers (Member 1) ----------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function me() { return get(/databases/$(database)/documents/users/$(uid())).data; }
    function isAdmin() { return signedIn() && me().role == 'ADMIN'; }
    function hasRole(r) { return signedIn() && me().role == r; }

    // ---------- Member 1 – Users and roles ----------
    match /users/{userId} {
      allow read: if signedIn();
      // Public registration: own profile only, never ADMIN, always active.
      allow create: if signedIn() && userId == uid()
                    && request.resource.data.role != 'ADMIN'
                    && request.resource.data.isActive == true;
      // Users edit their own profile but not their role or active flag;
      // admins manage everyone except themselves.
      allow update: if (signedIn() && userId == uid()
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.isActive == resource.data.isActive)
                    || (isAdmin() && userId != uid());
    }

    // ---------- Member 1 – Problem reports ----------
    match /problemReports/{id} {
      allow create: if signedIn() && request.resource.data.userId == uid();
      allow read, update: if isAdmin();
    }

    // ---------- Member 6 – Notifications and eco points ----------
    match /notifications/{id} {
      allow read, update: if signedIn() && resource.data.userId == uid();
      allow create: if signedIn();
    }
    match /ecoActions/{id} {
      allow read: if signedIn();
      // Fixed id `TYPE_refId` + transaction: one award per activity, never edited.
      allow create: if signedIn();
    }

    // ---------- Other modules: add your blocks below ----------

    // ---------- Member 3 – Smart Recommendation, Discovery & Search ----------
    match /items/{itemId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == uid();
      allow update, delete: if signedIn() && resource.data.ownerId == uid();
    }

    match /providers/{providerId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /listings/{listingId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && (resource.data.ownerId == uid() || isAdmin());
    }

    match /recycling_requests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && (resource.data.userId == uid() || isAdmin());
    }
  }
}
