{
  "name": "revivex-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "bcryptjs": "^3.0.3",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "2.0.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.6",
    "prisma": "6.16.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
