generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Member 1 – Authentication & User Management
// Shared foundation: other modules reference User.id as a FK.
// ============================================================

enum Role {
  ITEM_OWNER
  SERVICE_PROVIDER
  BUYER
  RECYCLER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(ITEM_OWNER)
  phone        String?
  profileImage String?  @map("profile_image")
  latitude     Float?
  longitude    Float?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ecoActions    EcoAction[]
  notifications Notification[]

  @@index([role])
  @@map("users")
}

// ============================================================
// Member 6 – Eco Impact
// One row per completed sustainable action. Other modules record
// them through awardEcoPoints() when a repair, sale, donation,
// reuse or recycling request is completed.
// ============================================================

enum EcoActionType {
  REPAIR
  REUSE
  SELL
  DONATE
  RECYCLE
}

model EcoAction {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           EcoActionType
  points         Int
  /// Id of the completed record (repair request, listing, recycling request).
  refId          String        @map("ref_id")
  /// PHONE, LAPTOP, TABLET, DESKTOP, MONITOR, PRINTER, HEADPHONES, KEYBOARD, CAMERA, BATTERY_CHARGER or OTHER
  deviceCategory String        @default("OTHER") @map("device_category")
  /// Estimated CO2 emissions avoided by this activity, in kg.
  co2SavedKg     Float         @default(0) @map("co2_saved_kg")
  /// Estimated weight of electronics kept out of landfill, in kg.
  ewasteKg       Float         @default(0) @map("ewaste_kg")
  createdAt      DateTime      @default(now()) @map("created_at")

  /// The same completed activity can only earn points once.
  @@unique([type, refId])
  @@index([userId])
  @@map("eco_actions")
}

// ============================================================
// Member 6 – In-app notifications
// Created by any module through notify() when something the
// user should know about happens (status change, points earned).
// ============================================================

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ECO, REPAIR, LISTING, RECYCLING, REVIEW or GENERAL
  type      String    @default("GENERAL")
  title     String
  message   String
  /// Id of the related record (repair request, listing, eco action...), if any.
  refId     String?   @map("ref_id")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("notifications")
}
