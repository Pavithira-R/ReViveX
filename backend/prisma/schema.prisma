generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// Member 1 – Authentication & User Management
// Shared foundation: other modules reference User.id as a FK.
// ============================================================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("ITEM_OWNER")
  phone        String?
  profileImage String?  @map("profile_image")
  latitude     Float?
  longitude    Float?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ecoActions EcoAction[]

  @@index([role])
  @@map("users")
}

// ============================================================
// Member 6 – Eco Impact
// One row per completed sustainable action. Other modules record
// them through awardEcoPoints() when a repair, sale, donation,
// reuse or recycling request is completed.
// ============================================================

model EcoAction {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  points    Int
  /// Id of the completed record (repair request, listing, recycling request).
  refId     String   @map("ref_id")
  createdAt DateTime @default(now()) @map("created_at")

  /// The same completed activity can only earn points once.
  @@unique([type, refId])
  @@index([userId])
  @@map("eco_actions")
}
