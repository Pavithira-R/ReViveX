# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/revivex_db?schema=public"

# Authentication (JWT)
# Use a long random string. Required when NODE_ENV=production.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Initial admin account created by `npm run db:seed`
ADMIN_NAME=ReViveX Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
